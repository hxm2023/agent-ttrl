{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ttrl.local/schemas/branch_record.schema.json",
  "title": "BranchRecord",
  "description": "One matched counterfactual branch. selection_probability in (0,1]; coupling_seed 64-bit integer (design doc §7.3/§16.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "branch_id", "parent_trajectory_ref", "decision_span_ref",
    "selection_probability", "restore_snapshot_sha256", "behavior_policy_ref",
    "alternative_action_tokens_ref", "continuation_protocol_sha256",
    "coupling_seed", "evidence_bundle_ref", "action_idx", "group_id"
  ],
  "properties": {
    "schema_version": { "const": "agent-ttrl.branch-record.v1" },
    "branch_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parent_trajectory_ref": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision_span_ref": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selection_probability": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "restore_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "behavior_policy_ref": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "alternative_action_tokens_ref": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "continuation_protocol_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "coupling_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "evidence_bundle_ref": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "action_idx": { "type": "integer", "minimum": 0 },
    "group_id": { "type": "string", "minLength": 1 }
  }
}
