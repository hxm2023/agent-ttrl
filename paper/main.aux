\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}F1: static serving produces pure-RNG artifacts}{4}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The three-stage audit arc: each protocol fix changes the conclusion. F1 (static serving): update arms indistinguishable from frozen (96/96 identical outcomes). F2 (leakage): phantom transfer $+0.070$ ($p{=}0.016$). F3 (full isolation): updates significantly harmful ($-0.19$, $p{=}0.008$); the pre-commit gate restores parity.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:audit}{{2}{5}{The three-stage audit arc: each protocol fix changes the conclusion. F1 (static serving): update arms indistinguishable from frozen (96/96 identical outcomes). F2 (leakage): phantom transfer $+0.070$ ($p{=}0.016$). F3 (full isolation): updates significantly harmful ($-0.19$, $p{=}0.008$); the pre-commit gate restores parity}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-seed AUPC under full protocol isolation (v3): frozen is deterministic across seeds; naive and egc are below frozen on all 8 seeds (exact two-sided $p{=}0.008$).}}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:v3}{{3}{5}{Per-seed AUPC under full protocol isolation (v3): frozen is deterministic across seeds; naive and egc are below frozen on all 8 seeds (exact two-sided $p{=}0.008$)}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}F2: evaluator leakage and anchor injection produce phantom transfer}{5}{subsection.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}F3: protocol-correct updates are significantly harmful}{5}{subsection.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Gated updates restore parity}{6}{subsection.5.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Update-rule alternatives do not recover transfer}{6}{subsection.5.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Summary}{6}{subsection.5.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Positive Control: Full Task Completion on the Official tau2 Benchmark}{6}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cumulative loose-gate updates degrade first-attempt success monotonically on both backbones (Mistral collapses by task ~20; Qwen decays 0.75$\to $0.125 across the 32-task stream). The frozen rate is the dotted line.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:decay}{{4}{7}{Cumulative loose-gate updates degrade first-attempt success monotonically on both backbones (Mistral collapses by task ~20; Qwen decays 0.75$\to $0.125 across the 32-task stream). The frozen rate is the dotted line}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces F3 mechanism: per-template first-attempt AUPC, frozen vs.\ naive. On both backbones the degradation concentrates on the templates the frozen policy solved, while never-solved templates stay flat (and on Qwen the hardest variant even improves $+0.2$). The update suppresses the action patterns it trained on with mixed credit.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:mechanism}{{5}{7}{F3 mechanism: per-template first-attempt AUPC, frozen vs.\^^Mnaive. On both backbones the degradation concentrates on the templates the frozen policy solved, while never-solved templates stay flat (and on Qwen the hardest variant even improves $+0.2$). The update suppresses the action patterns it trained on with mixed credit}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}The audit arc replicates on the official environment}{8}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces A successful task-2 trajectory on the official tau2 retail environment (local Qwen2.5-14B): the agent finds the user, counts the 10 \emph  {available} t-shirt variants, communicates the count, locates the items, and executes the three-item return with real ids. The hidden evaluator scores DB $1.0$ and NL-assertion $1.0$.}}{8}{figure.caption.13}\protected@file@percent }
\newlabel{fig:tau2}{{6}{8}{A successful task-2 trajectory on the official tau2 retail environment (local Qwen2.5-14B): the agent finds the user, counts the 10 \emph {available} t-shirt variants, communicates the count, locates the items, and executes the three-item return with real ids. The hidden evaluator scores DB $1.0$ and NL-assertion $1.0$}{figure.caption.13}{}}
